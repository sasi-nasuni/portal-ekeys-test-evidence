{
  "operation": {
    "tags": [
      "Encryption Keys"
    ],
    "summary": "List Encryption Keys by Volume",
    "description": "\u26a0\ufe0f **Private preview.** Contact your Nasuni account team to request access.\n\nList volumes with their owner's matching encryption keys.\n\nPagination applies to volumes. Each volume includes its complete matching\nkey list and active or unacknowledged failed operations. Search selects\nvolumes; origin and key-state filters narrow the returned keys.\n\nResults reflect current data on each request. New volumes after the current\nposition may appear on later pages. Changes to the selected sort fields can\ncause entries to repeat or be missed, and totals can change between pages.\nRestart pagination to refresh the full list.",
    "operationId": "list_volume_encryption_keys_volumes_encryption_keys_get",
    "security": [
      {
        "HTTPBearer": []
      }
    ],
    "parameters": [
      {
        "name": "search",
        "in": "query",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Search"
        }
      },
      {
        "name": "volume_ids",
        "in": "query",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Volume Ids"
        }
      },
      {
        "name": "appliance_ids",
        "in": "query",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Appliance Ids"
        }
      },
      {
        "name": "origin",
        "in": "query",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EncryptionKeyOrigin"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Origin"
        }
      },
      {
        "name": "key_state",
        "in": "query",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/VolumeEncryptionKeyState"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Key State"
        }
      },
      {
        "name": "sort_by",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/VolumeKeysSortBy",
          "default": "volume_name"
        }
      },
      {
        "name": "sort_direction",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/SortDirection",
          "default": "asc"
        }
      },
      {
        "name": "iterator_id",
        "in": "query",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "title": "Iterator Id"
        }
      },
      {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Page of volumes; defaults to the next iterator page or the first page",
          "title": "Page"
        },
        "description": "Page of volumes; defaults to the next iterator page or the first page"
      },
      {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "maximum": 25,
          "minimum": 1,
          "description": "Maximum number of volumes per page",
          "default": 25,
          "title": "Limit"
        },
        "description": "Maximum number of volumes per page"
      }
    ],
    "responses": {
      "200": {
        "description": "A page of volumes, each with its complete matching encryption-key list",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VolumeEncryptionKeysListDto"
            }
          }
        }
      },
      "401": {
        "description": "Not authenticated",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "403": {
        "description": "The encryption keys feature is unavailable, or View Volume Encryption Keys permission is missing",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "500": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "422": {
        "description": "Invalid input data",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            }
          }
        }
      },
      "429": {
        "description": "Too many requests (rate limit exceeded)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "400": {
        "description": "The iterator is invalid, expired, or does not match the current filters, sort order, or page size",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "schemas": {
    "ApplianceIdentityDto": {
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "title": "Id"
        },
        "name": {
          "type": "string",
          "title": "Name"
        }
      },
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "title": "ApplianceIdentityDto",
      "description": "An appliance's identifier and name."
    },
    "EncryptionKeyPaginationMetadataDto": {
      "properties": {
        "iterator_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "title": "Iterator Id"
        },
        "page_size": {
          "type": "integer",
          "title": "Page Size",
          "default": 50
        },
        "total_pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Pages"
        },
        "total_items": {
          "type": "integer",
          "title": "Total Items"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        }
      },
      "type": "object",
      "required": [
        "total_items"
      ],
      "title": "EncryptionKeyPaginationMetadataDto",
      "description": "Pagination metadata for encryption-key list responses."
    },
    "VolumeEncryptionKeysDto": {
      "properties": {
        "volume_id": {
          "type": "string",
          "title": "Volume Id"
        },
        "volume_name": {
          "type": "string",
          "title": "Volume Name"
        },
        "owner_appliance": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/ApplianceIdentityDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "keys": {
          "items": {
            "$ref": "#/components/schemas/VolumeKeyDto"
          },
          "type": "array",
          "title": "Keys"
        },
        "tasks": {
          "items": {
            "$ref": "#/components/schemas/ResourceTaskDto"
          },
          "type": "array",
          "title": "Tasks",
          "description": "Active or unacknowledged failed operations on the volume's key collection"
        }
      },
      "type": "object",
      "required": [
        "volume_id",
        "volume_name",
        "owner_appliance",
        "keys"
      ],
      "title": "VolumeEncryptionKeysDto",
      "description": "A volume and its owner's matching encryption keys."
    },
    "VolumeEncryptionKeysListDto": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/components/schemas/VolumeEncryptionKeysDto"
          },
          "type": "array",
          "title": "Items"
        },
        "metadata": {
          "$ref": "#/components/schemas/EncryptionKeyPaginationMetadataDto"
        }
      },
      "type": "object",
      "required": [
        "items",
        "metadata"
      ],
      "title": "VolumeEncryptionKeysListDto",
      "description": "A page of volumes, each with its complete matching encryption-key list."
    },
    "VolumeEncryptionKeysResponseDto": {
      "properties": {
        "volume_id": {
          "type": "string",
          "title": "Volume Id"
        },
        "tasks": {
          "items": {
            "$ref": "#/components/schemas/ResourceTaskDto"
          },
          "type": "array",
          "title": "Tasks"
        },
        "items": {
          "items": {
            "$ref": "#/components/schemas/VolumeKeyDto"
          },
          "type": "array",
          "title": "Items"
        }
      },
      "type": "object",
      "required": [
        "volume_id"
      ],
      "title": "VolumeEncryptionKeysResponseDto",
      "description": "A volume's encryption keys and shared collection-level operations."
    },
    "VolumeKeyDto": {
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^(?:[0-9A-F]{32}|[0-9A-F]{40}|[0-9A-F]{64})$",
          "title": "Fingerprint"
        },
        "algorithm": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/EncryptionKeyAlgorithm"
            },
            {
              "type": "null"
            }
          ]
        },
        "length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Length"
        },
        "origin": {
          "$ref": "#/components/schemas/EncryptionKeyOrigin"
        },
        "state": {
          "$ref": "#/components/schemas/VolumeEncryptionKeyState"
        },
        "status": {
          "$ref": "#/components/schemas/ResourceSyncStatus"
        },
        "tasks": {
          "items": {
            "$ref": "#/components/schemas/ResourceTaskDto"
          },
          "type": "array",
          "title": "Tasks"
        }
      },
      "type": "object",
      "required": [
        "id",
        "fingerprint",
        "origin",
        "state",
        "status"
      ],
      "title": "VolumeKeyDto",
      "description": "An encryption key associated with one volume."
    },
    "VolumeKeysSortBy": {
      "type": "string",
      "enum": [
        "volume_name",
        "appliance_name"
      ],
      "title": "VolumeKeysSortBy"
    }
  }
}
